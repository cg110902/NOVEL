{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "novel-studio.stress-manifest/v1",
  "description": "压力测试 manifest（plan/actual 共用外壳；plan 为 ground truth，actual 为 state 反向投影；diff 必须为空——见 tests/stress/generator.py）。此处只锁外壳与不变字段，明细结构以生成器为准。",
  "type": "object",
  "required": ["schema", "stage", "scale", "seed", "chapters"],
  "properties": {
    "schema": {"const": "novel-studio.stress-manifest/v1"},
    "stage": {"enum": ["plan", "actual"]},
    "canon": {"type": "string", "pattern": "^[0-9a-f]{16,64}$", "description": "canon_manifest(plan)：确定性指纹，同 (scale,seed) 必须同值"},
    "scale": {"enum": ["smoke", "full", "chap-hell", "word-hell"]},
    "seed": {"type": "integer"},
    "chapters": {"type": "integer", "minimum": 1},
    "lines": {"type": "object", "description": "lid -> {kind, plant_ch, target(int|\"longline\"), recall_ch|null, tier, weight}"},
    "ledger_replay": {"type": "object", "description": "pool -> [{ch, balance}]（plan 侧独立重放）"},
    "clock_trace": {"type": "array", "items": {"type": "object", "required": ["ch", "time_day"]}},
    "faults": {"type": "array", "items": {"type": "object", "required": ["fault_id", "type", "inject_ch", "expect_code"], "properties": {"fault_id": {"type": "string"}, "expect_code": {"type": ["string", "null"]}}}}
  }
}
