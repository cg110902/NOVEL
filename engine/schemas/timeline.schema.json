{
  "type": "object",
  "required": [
    "events",
    "arcs"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "event"
        ],
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "chapter": {
            "type": "string"
          }
        }
      }
    },
    "arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "baseline": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "inciting_event": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          },
          "ultimate": {
            "type": "string"
          },
          "strategy_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chapter",
                "strategy"
              ],
              "additionalProperties": false,
              "properties": {
                "chapter": {
                  "type": "string"
                },
                "strategy": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "clocks": {
      "type": "array",
      "description": "危机/重大事件倒计时时钟（自动在 pack 中计算剩余章数并生成紧迫感提醒）",
      "items": {
        "type": "object",
        "required": [
          "name",
          "target_ch"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "时钟名称（如'宗门大比'、'三年之约'、'毒发倒计时'）"
          },
          "target_ch": {
            "type": "integer",
            "minimum": 1,
            "description": "目标爆发/结算章号"
          },
          "urgency": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "紧迫等级"
          },
          "desc": {
            "type": "string",
            "description": "危机内容与超时后果简述"
          },
          "status": {
            "enum": [
              "Active",
              "Triggered",
              "Defused",
              "Expired"
            ],
            "description": "时钟状态：Active(进行中) / Triggered(已引爆) / Defused(已解除) / Expired(已逾期)"
          }
        }
      }
    }
  }
}
