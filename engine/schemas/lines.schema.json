{
  "type": "object",
  "required": [
    "foreshadows",
    "misunderstandings",
    "knowledge"
  ],
  "properties": {
    "foreshadows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "plant_ch",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GUN-\\d{3,}$"
          },
          "name": {
            "type": "string"
          },
          "plant_ch": {
            "type": "integer",
            "minimum": 1,
            "description": "埋设章节号（正整数章号；缺省由引擎用提案章节补全）"
          },
          "status": {
            "enum": [
              "Planted",
              "Reminded",
              "Resolved"
            ]
          },
          "target_ch": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "const": "longline"
              }
            ],
            "description": "引爆章号（≥1 的正整数）或 'longline'（长线，无固定章）"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "description": "权重（语义分级，建议 1-3，越大越优先还）；缺省 1。逾期清单按权重排序出数。"
          },
          "plan": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" },
            "description": "前置依赖线索ID列表（如 ['GUN-001']）"
          }
        }
      }
    },
    "misunderstandings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parties",
          "content",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MIS-\\d{3,}$"
          },
          "parties": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "truth": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "description": "误会强度（≥1 的整数，越大越难解）"
          },
          "target_ch": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "const": "longline"
              }
            ],
            "description": "澄清章号（≥1）或 'longline'（长线）"
          },
          "status": {
            "enum": [
              "Active",
              "Escalated",
              "Resolved"
            ]
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" },
            "description": "前置依赖线索ID列表（如 ['GUN-001']）"
          }
        }
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "secret",
          "plant_ch",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KNO-\\d{3,}$"
          },
          "secret": {
            "type": "string",
            "description": "这条信息/秘密是什么（一句话事实，不写感受）"
          },
          "plant_ch": {
            "type": "integer",
            "minimum": 1,
            "description": "信息确立/被隐瞒的章节号（缺省由引擎用提案章节补全）"
          },
          "status": {
            "enum": [
              "Concealed",
              "Revealed"
            ]
          },
          "target_ch": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "const": "longline"
              }
            ],
            "description": "计划揭示章号（≥1）或 'longline'（长线）"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "description": "权重（语义分级，建议 1-3，越大越优先揭示）；缺省 1。逾期清单按权重排序出数。"
          },
          "note": {
            "type": "string",
            "description": "可选：谁不得知道 / 揭示约束（一句话）"
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" },
            "description": "前置依赖线索ID列表（如 ['GUN-001']）"
          }
        }
      }
    }
  }
}