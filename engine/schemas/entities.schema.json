{
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "person",
              "item",
              "place",
              "faction",
              "other"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "card": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "realm": {
            "type": "string",
            "description": "（person 用）境界/阶位/社会职务（如'练气四层'、'刑警队长'）"
          },
          "faction": {
            "type": "string",
            "description": "（person 用）所属势力/组织名"
          },
          "life_status": {
            "enum": [
              "alive",
              "deceased",
              "missing"
            ],
            "description": "（person 用）生命状态：alive(存活) / deceased(战死/离世) / missing(失踪)"
          },
          "attitude": {
            "enum": [
              "hostile",
              "neutral",
              "friendly",
              "allied"
            ],
            "description": "（faction 用）对主角/主角团的政治与阵营立场"
          },
          "holder": {
            "type": "string",
            "description": "（item 用）当前持有者名；必须已在 entities 注册（sync 闭合校验）"
          },
          "location": {
            "type": "string",
            "description": "（item 用）当前所在地点（自由文本）"
          },
          "condition": {
            "type": "string",
            "description": "（item 用）当前完损/状态（如'完整''毁于火'）"
          },
          "charges": {
            "type": "integer",
            "minimum": 0,
            "description": "（item 用）剩余使用次数/充能点数"
          },
          "max_charges": {
            "type": "integer",
            "minimum": 1,
            "description": "（item 用）最大使用次数/充能上限"
          },
          "dossier": {
            "type": "string",
            "description": "（person/faction 用）与主角的恩怨羁绊、历史过节与交互备忘（如'ch_002 曾被主角暗算，怀恨在心'）"
          },
          "scope": {
            "type": "string",
            "description": "所属分卷生命周期（如 vol_01；省略表示全书通用）"
          },
          "golden_quote": {
            "type": "string",
            "description": "首次高光定稿切片（100~200字物象细节）"
          },
          "relations": {
            "type": "array",
            "description": "与特定角色的动态张力关系清单",
            "items": {
              "type": "object",
              "required": ["target", "type"],
              "additionalProperties": false,
              "properties": {
                "target": { "type": "string" },
                "type": { "type": "string" },
                "desc": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
