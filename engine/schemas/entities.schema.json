{
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "person",
              "item",
              "place",
              "faction",
              "other"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "card": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "holder": {
            "type": "string",
            "description": "（item 用）当前持有者名；必须已在 entities 注册（sync 闭合校验）"
          },
          "location": {
            "type": "string",
            "description": "（item 用）当前所在地点（自由文本）"
          },
          "condition": {
            "type": "string",
            "description": "（item 用）当前完损/状态（如'完整''毁于火'）"
          }
        }
      }
    }
  }
}
